# ---------------------------------------------------------------------------
# Dressly environment
# Copy to `.env.local` and fill in the keys you have. Every variable is read
# on the server. Keep secrets out of NEXT_PUBLIC_* variables and version control.
# ---------------------------------------------------------------------------

# Persistence: local for development; set supabase in Vercel.
DRESSLY_STORAGE_BACKEND=local
# Required when DRESSLY_STORAGE_BACKEND=supabase. Server-side secret key only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=dressly-private

# YouCam / Perfect Corp — the core virtual try-on engine (required for a real demo)
YOUCAM_API_KEY=
YOUCAM_API_URL=https://yce-api-01.makeupar.com
YOUCAM_POLL_INTERVAL_MS=3000
YOUCAM_TIMEOUT_MS=120000

# JEV / TypeSafe System One — the decision engine (required for a real demo)
TYPESAFE_API_KEY=
# Origin only: the SDK appends its own fixed /v1/systemone path.
TYPESAFE_API_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=20000

# Gemini — language understanding (required for a real demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_LIVE_MODEL=gemini-3.8-live

# Runway — optional animation and Live Consultation design generation
RUNWAY_API_KEY=
RUNWAY_API_URL=https://api.dev.runwayml.com
# Any image-to-video model the Runway API exposes. Examples:
#   gemini_omni_flash_1.1  Google Gemini Omni, hosted by Runway (portrait/landscape, 3-10s)
#   gen4_turbo             Runway's own fast image-to-video
#   veo3.1  seedance2  wan3  ...
RUNWAY_MODEL=gemini_omni_flash_1.1
# Must be a ratio + duration the chosen model supports. gemini_omni_flash_1.1:
#   ratio: 720:1280 or 1280:720;  duration: 3-10
RUNWAY_RATIO=720:1280
RUNWAY_DURATION_SECONDS=5
RUNWAY_ENABLED=false

# Development only. Simulates provider responses with a visible watermark.
# Never use this for a recorded or judged demo.
DRESSLY_MOCK_EXTERNAL_APIS=false

# Preloads a curated brief but STILL uses the real providers.
DRESSLY_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Live Design Consultation (Runway Nano Banana 2.1 + Meeting Bot Worker)
# ---------------------------------------------------------------------------

# Runway text_to_image model and 3:4 portrait ratio for iterative product design
RUNWAY_IMAGE_MODEL=nano_banana_2.1
RUNWAY_IMAGE_RATIO=896:1200

# Preloads the V1 burgundy structured top-handle bag & demo helpers while calling real providers
DRESSLY_CONSULTATION_DEMO_MODE=false

# Minimum confidence (0.5..1.0) required when AUTO APPLY is toggled on
CONSULTATION_AUTO_APPLY_THRESHOLD=0.90

# Isolated Playwright + Chromium Google Meet bot worker
MEETING_BOT_PORT=4100
# Vercel requires a separately hosted HTTPS worker. Never use localhost there.
MEETING_BOT_URL=http://127.0.0.1:4100
# Local development only. On public deployments use the same random secret of
# at least 32 characters on the application and worker; do not share it publicly.
MEETING_BOT_SECRET=dressly-local-bot-secret
# Vercel: set to the publicly reachable HTTPS application origin for bot callbacks.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
MEETING_BOT_PROFILE_DIR=data/bot-profile
# Default false (headed mode) so Google Meet WebRTC media works and manual sign-in/2FA is visible
MEETING_BOT_HEADLESS=false

# Audio capture backend: "auto" | "webrtc-tap" | "pulseaudio"
MEETING_AUDIO_BACKEND=auto

# Optional binary path overrides (auto-detected when omitted)
CHROMIUM_EXECUTABLE_PATH=
FFMPEG_PATH=
