# ---------------------------------------------------------------------------
# Dressly environment
# Copy to `.env.local` and fill in the keys you have. Every variable is read
# only on the server, in `lib/env.ts`. No key ever reaches the browser.
# ---------------------------------------------------------------------------

# YouCam / Perfect Corp — the core virtual try-on engine (required for a real demo)
YOUCAM_API_KEY=
YOUCAM_API_URL=https://yce-api-01.makeupar.com
YOUCAM_POLL_INTERVAL_MS=3000
YOUCAM_TIMEOUT_MS=120000

# JEV / TypeSafe System One — the decision engine (required for a real demo)
TYPESAFE_API_KEY=
# Origin only: the SDK appends its own fixed /v1/systemone path.
TYPESAFE_API_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=20000

# Gemini — language understanding (required for a real demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# Runway — optional P2 animation only
RUNWAY_API_KEY=
RUNWAY_API_URL=https://api.dev.runwayml.com
RUNWAY_MODEL=gen4_turbo
RUNWAY_ENABLED=false

# Development only. Simulates provider responses with a visible watermark.
# Never use this for a recorded or judged demo.
DRESSLY_MOCK_EXTERNAL_APIS=false

# Preloads a curated brief but STILL uses the real providers.
DRESSLY_DEMO_MODE=false
